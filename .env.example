# Copy this file to .env for local development. Do not commit .env.
APP_ENV=development
POSTGRES_DB=takdora
POSTGRES_USER=takdora
POSTGRES_PASSWORD=takdora
DATABASE_URL=postgresql+psycopg://takdora:takdora@db:5432/takdora
API_URL=http://localhost:8000
# Required only in production; use a unique high-entropy value.
APP_SECRET_KEY=
# Optional. Leave blank locally; never put a real DSN in Git.
SENTRY_DSN=
PORT=10000
